     "constraints": [
      {
       "code": "SUBJECT_PRODUCT_REQUIRES_PRODUCT_ID",
       "expression": "subject_kind_value_id <> 'PRODUCT' OR product_id IS NOT NULL",
       "error_message_text": "Una no-conformidad con sujeto PRODUCT exige product_id."
      },
      {
       "code": "SUBJECT_LOT_REQUIRES_LOT_ID",
       "expression": "subject_kind_value_id <> 'LOT' OR lot_id IS NOT NULL",
       "error_message_text": "Una no-conformidad con sujeto LOT exige lot_id."
      },
      {
       "code": "SUBJECT_POINT_REQUIRES_POINT_OF_SALE_ID",
       "expression": "subject_kind_value_id <> 'POINT' OR point_of_sale_id IS NOT NULL",
       "error_message_text": "Una no-conformidad con sujeto POINT exige point_of_sale_id."
      },
      {
       "code": "SUBJECT_POINT_FORBIDS_PRODUCT_AND_LOT",
       "expression": "subject_kind_value_id <> 'POINT' OR (product_id IS NULL AND lot_id IS NULL)",
       "error_message_text": "Una no-conformidad del propio punto no lleva producto ni lote; si los lleva, el sujeto es PRODUCT o LOT."
      },
      {
       "code": "SOURCE_INSPECTION_REQUIRES_INSPECTION_ID",
       "expression": "source_value_id <> 'INSPECTION' OR quality_inspection_id IS NOT NULL",
       "error_message_text": "Si el origen es INSPECTION, quality_inspection_id es obligatorio."
      }
